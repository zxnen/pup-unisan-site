# Placeholders only. Copy to .env for local use (never commit .env).
# These two are PUBLIC values (safe in the browser); they are read by scripts/generate-config.mjs.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
FACULTY_SUPABASE_URL=https://YOUR-FACULTY-PROJECT-REF.supabase.co
FACULTY_SUPABASE_PUBLISHABLE_KEY=YOUR_FACULTY_PUBLISHABLE_OR_ANON_KEY
TURNSTILE_SITE_KEY=YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY

# Server-only Netlify function variables. Never put these in js/config.js or client builds.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_MAIN_PROJECT_SERVICE_ROLE_KEY
# FACULTY_SUPABASE_SERVICE_ROLE_KEY=YOUR_FACULTY_PROJECT_SERVICE_ROLE_KEY
# TURNSTILE_SECRET_KEY=YOUR_CLOUDFLARE_TURNSTILE_SECRET
# ABUSE_HASH_SECRET=GENERATE_A_RANDOM_SERVER_SECRET

# NEVER put these in the frontend, in Netlify env vars used by the build, or in Git:
#   SUPABASE_SERVICE_ROLE_KEY, database password, Google OAuth client secret
